NEXT_PUBLIC_SITE_URL=https://www.spnc.cn
NEXT_PUBLIC_TAOBAO_STORE_URL=https://spnc.taobao.com

# 售后工单：在 Vercel 项目 Storage 中创建 Private Blob 后自动生成。
BLOB_READ_WRITE_TOKEN=
TICKET_HASH_SALT=

# 可选：合规文件 Batch 与 10 分钟访问凭证的独立签名密钥；未配置时沿用 TICKET_HASH_SALT。
COMPLIANCE_ACCESS_SECRET=

# Cloudflare Turnstile：公开表单的站点密钥与服务器密钥。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 工单后台：只保存于本地 .env.local 与 Vercel Environment Variables。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 可选：新工单邮件提醒。未配置时工单仍会保存到后台。
RESEND_API_KEY=
TICKET_NOTIFICATION_FROM=
